{
  "openapi": "3.0.1",
  "info": {
    "title": "RentalWorks QuikScan API v1",
    "version": "v1"
  },
  "paths": {
    "/quikscan/assetdisposition/lookupretiredreason": {
      "get": {
        "tags": [
          "AssetDisposition"
        ],
        "summary": "Get a list of valid Retired Reasons",
        "parameters": [
          {
            "name": "RetiredReasonId",
            "in": "query",
            "description": "Retired Reason Identifier [Key|Filter]",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RetiredReason",
            "in": "query",
            "description": "Reason for retiring an item. [Filter|Sort]",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReasonType",
            "in": "query",
            "description": "Category to use for filtering Retired Reasons for different purposes. [Filter|Sort] {OTHER|INVENTORY|CHANGECODE|LOST|STOLEN|DONATED|SOLD}",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "PageNo",
            "in": "query",
            "description": "The page number in the result set starting from 1.  PageNo is required when the PageSize is specified.",
            "schema": {
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Limit result set to the specified amount.",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Sort",
            "in": "query",
            "description": "A sort expression to use of the form: Field1:asc,Field2:desc",
            "schema": {
              "maxLength": 1024,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FwStandard.Models.GetResponse_WebApi.Modules.Mobile.AssetDisposition.LookupRetiredReasonResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FwCore.Api.Swashbuckle.BadRequestResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (jwt token is invalid)"
          },
          "403": {
            "description": "Forbidden (jwt token is valid, but you don't have permission)"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FwStandard.Models.FwApiException"
                }
              }
            }
          }
        }
      }
    },
    "/quikscan/fillcontainer/scannableitem/{scannableinventoryid}/lookuprentalinventory": {
      "get": {
        "tags": [
          "FillContainer"
        ],
        "summary": "Get a list of valid Container Descriptions.",
