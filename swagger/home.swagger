    "/deal/{dealid}/documents": {
      "get": {
        "tags": [
          "Deal"
        ],
        "summary": "Get documents.",
        "parameters": [
          {
            "name": "dealid",
            "in": "path",
            "description": "Unique identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DocumentTypeId",
            "in": "query",
            "description": "Unique Identifier [Filter|Sort]",
            "schema": {
              "maxLength": 8,
              "type": "string"
            }
          },
          {
            "name": "Description",
            "in": "query",
            "description": "Document description [Filter|Sort]",
            "schema": {
              "maxLength": 8,
              "type": "string"
            }
          },
          {
            "name": "DateStamp",
            "in": "query",
            "description": "Document last modified data [Filter|Sort]",
            "schema": {
              "maxLength": 8,
              "type": "string"
            }
          },
          {
            "name": "PageNo",
            "in": "query",
            "description": "The page number in the result set starting from 1.  PageNo is required when the PageSize is specified.",
            "schema": {
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Limit result set to the specified amount.",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Sort",
            "in": "query",
            "description": "A sort expression to use of the form: Field1:asc,Field2:desc",
            "schema": {
              "maxLength": 1024,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FwStandard.Models.GetResponse_FwStandard.Grids.AppDocument.AppDocumentGetManyResponse"
